#!/bin/sh
# Answers git's credential query from GH_TOKEN, so a clone made in conversation authenticates without
# the token ever sitting in an argument list, a transcript, or a shell history.
#
# Only the get operation is answered. store and erase are acknowledged and ignored: the token lives in
# the environment, handed to the sandbox by the system, and nothing here writes it anywhere.
case "$1" in
get)
    [ -n "$GH_TOKEN" ] || exit 0
    echo "username=x-access-token"
    echo "password=$GH_TOKEN"
    ;;
esac
exit 0
