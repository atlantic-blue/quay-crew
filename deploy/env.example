# The template for a crew's configuration. It is written to ~/.quay/env, which is where a crew keeps
# what belongs to it on this machine. `make install` writes it on a first run, and never writes over
# it again. Every `make up` and `make upgrade` reads that same file, so an upgrade cannot quietly
# bring the stack back as something else.
#
#   make install         # writes ~/.quay/env, builds everything, and brings the crew up
#   make config          # writes ~/.quay/env only, then edit it
#   make up              # brings the stack back on what you edited
#
# The file is outside this checkout on purpose. A crew that was installed rather than cloned has no
# checkout to keep configuration in, and configuration that lives in one cannot be given to anybody.
# Set QUAY_HOME to put it somewhere else.
#
# It holds configuration, never secrets: the model token is set at runtime with `quay secret set` and
# never written to disk here.

# The backend a task runs against. "claude-code" runs the real thing on your subscription; "echo" runs
# `echo` inside the sandbox instead, which is what continuous integration uses because it has no
# subscription.
QC_MODEL=claude-code

# Which model that backend runs against. An alias for the newest of a tier ("opus", "sonnet") or a
# full name ("claude-opus-5"). Leave it out and the crew still uses claude-opus-5, which is the
# default in the compose file.
#
# Without this the command line tool chooses for itself, and it chooses Sonnet, which is why every
# session was running Sonnet while the operator was paying for Opus.
QC_CLAUDE_MODEL=claude-opus-5

# What a session's tasks may do without asking, when the session is born: plan, edits or dangerous.
#
# plan reads and proposes and changes nothing. edits lets it change the files in its own working
# directory. dangerous lets it do anything, which in a sandbox means anything to one container
# holding one project's files.
#
# A dispatched task has nobody to approve anything, so a session born in a mode narrower than the work
# stops and asks somebody who is not there. `quay mode <session>` changes one session after the fact;
# this is what every new one starts as.
#
# Unset keeps edits, which is what every session had before this could be set. An unknown value stops
# the crew starting rather than quietly falling back.
QC_PERMISSION_MODE=edits

# How many tasks past its own description a conversation goes before the crew writes it again.
#
# A session describes itself after its first task, so a listing reads as conversations rather than as
# identifiers without anybody naming anything. After that it is rewritten when the conversation has
# moved on this far. Each one costs a model call, in its own conversation, so it never lands in your
# history and never counts towards what the listing says the session cost.
#
# Ten is a starting number, not a measured one. Nothing has run long enough yet to say how far a
# conversation drifts per task, so it is set here rather than presented as derived. What would replace
# it is a count of how often a rewrite actually differs from the description before it.
#
# "off" tasks it off entirely, which a crew running automation wants: a flow makes a session per run.
# Your own name for a session is never touched by any of this.
QC_DESCRIBE_EVERY=10

# The image a session's sandbox runs. Build it with `make sandbox-image`.
QC_SANDBOX_IMAGE=quaycrew-sandbox-claude:local

# How much memory one session may take, as the daemon spells it, for example 4g. Commented out gives
# a session no limit of its own, which is what every session had before this key existed.
#
# A sandbox with no limit reports the whole machine in /proc/meminfo. So node sizes its heap from it,
# Go sizes its collector from it, and jest and webpack start one worker for each processor, while
# what is actually there is whatever the rest of the machine has not taken. The session budgets
# against the first number and the kernel kills it against the second, with signal 9 and nothing
# said. Set this and the number a session reads is the number it is held to.
#
# It is a share of one machine between the stack, every session already running, and this one. Add up
# what you are willing to give them and check it against what the daemon has. `quay room` inside a
# session reports whichever of the two it got.
# QC_SANDBOX_MEMORY=4g

# Where a workspace's conversations and a project's files are kept. Defaults to ~/.quay/data.
# QC_DATA_HOST=/Volumes/work/quaycrew

# The crew's token lives at <data directory>/crew.token, minted by the control plane the first time
# it starts. Every caller has to present it; quay reads it from that file on this machine, so there
# is nothing to set here. From another machine, or from a script, export QC_TOKEN with the file's
# contents. The port is published on loopback only; publish it wider only behind transport you own.
# The driver holds its own token, driver.token beside it, which the crew refuses the calls that
# grant capability: a session that can drive the crew cannot grant itself anything.

# Whether a session can drive the crew. Together these put `quay` inside a sandbox on the control
# plane's network with an address to dial, so an agent in a session can make a workspace, start a
# session or set a context the same way you do.
#
# It is a real widening: a session that can drive the crew can also stop other sessions. The sandbox
# is what bounds it, over what is mounted in. Comment both out and a session can reach nothing of ours.
#
# The network is named after the compose project, which is quaycrew.
QC_SANDBOX_NETWORK=quaycrew_default
QC_SANDBOX_CONTROL_PLANE=controlplane:50051

# There is nothing here about which secrets a sandbox is given. A workspace's secrets reach that
# workspace's sandboxes, so `quay secret set <workspace> <name> <value>` is the whole of it and a
# session is running with the value on its next task. There used to be an allowlist here as well,
# which meant a secret could be set, and its skill attached, and the task still refused for a reason
# that lived in this file. Names starting QC_ are the exception and never travel: those are the
# crew's own configuration. See docs/SKILLS.md.

# The skills a session is given live in <data directory>/skills, one directory per skill, and the
# compose file finds them from QC_DATA_HOST. There is nothing to set here: put a skill in that
# directory and every session gets it. A skill is a directory with skill.yaml, SKILL.md and whatever
# else it needs. See docs/SKILLS.md.

# Who a commit made inside a sandbox is by. Both or neither: git wants an author and a committer and
# refuses on either missing, so half of this is the same as none of it and looks configured.
#
# `git` is in the sandbox image and unusable without this. A session asked to commit walks into
# "Please tell me who you are" halfway through whatever it was doing.
#
# QC_GIT_AUTHOR_NAME=Your Name
# QC_GIT_AUTHOR_EMAIL=you@example.com

# What the driver can see of this machine, as docker mounts, comma separated. The driver is the
# session that drives the crew, and this is what makes it the glue between the machine and the crew:
# without it the driver can reach the control plane and has nothing to bring to it.
#
# Only the driver gets these. Hand it what it needs and nothing else, and read only where it only has
# to read.
#
# QC_DRIVER_MOUNTS=/Users/you/claude:/home/agent/hub:ro

# How long the job controller holds a job before another controller may take it.
#
# Derived rather than chosen: the holder renews its hold on every tick while its task is open, so
# what this has to outlast is a gap between renewals rather than a task. A tick with nothing to do
# costs microseconds, so this is twelve tick intervals, which is the same budget the crew already
# gives the longest healthy operation it has. Provisional until there are fifty completed jobs to
# measure the gap over.
#
# Unset takes that default. Set it longer only if this crew's store is slow enough to miss twelve
# ticks in a row.
QC_JOB_LEASE=60s
