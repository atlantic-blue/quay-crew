# binaries
/bin/
/out/
*.exe

# env and secrets (secrets are set at runtime, never committed)
.env
.env.*
*.local

# local data volumes (event log, sessions, projections, secrets store)
.data/

# logs
*.log

# os / editor
.DS_Store
.idea/
.vscode/

# built hook entry points. A hook ships as an executable, and the executable is a build artifact:
# `make hooks` writes it, the image build writes it, and neither belongs in the history.
/hooks/*/bin/hook
